# PM Tool — Zone B HA pilot, backend SECRETS. Copy to /opt/pm-pilot/secrets.pilot.env,
# chmod 600, and replace every FILL_ value with nano. Never commit the filled file.

# The pilot's OWN database (never production). Percent-encode special characters in
# the password: @ -> %40, # -> %23, : -> %3A, / -> %2F, % -> %25
DATABASE_URL=postgres://pm_pilot:FILL_PM_PILOT_DB_PASSWORD@FILL_STAGING_RDS_HOST:5432/pm_pilot

# Signs the sign-in tokens. Generated on the server (guide section 7), 64 hex characters.
JWT_SECRET=FILL_JWT_SECRET

# The local password set-local-password.js gives your account (at least 12 characters).
PM_LOCAL_PASSWORD=FILL_LOCAL_PASSWORD
