# Compose variables for the Zone B pilot. Copy to /opt/pm-pilot/.env on EACH server and
# keep only that server's lines filled in.

# Both servers: the Docker subnet preflight.sh suggested on THAT server
PM_SUBNET=FILL_SUBNET_FROM_PREFLIGHT

# BE server (172.31.96.51)
PM_BE_IP=172.31.96.51
PM_NAS_MOUNT=/mnt/pm-pilot-nas

# FE server (172.31.96.50)
PM_FE_IP=172.31.96.50
PM_BACKENDS=172.31.96.51:13000 172.31.96.51:13001
