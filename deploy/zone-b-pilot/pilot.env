# PM Tool — Zone B HA pilot, backend settings (no secrets here).
# Copy to /opt/pm-pilot/pilot.env on the BE server; secrets go in secrets.pilot.env.
# The pilot is ISOLATED from production: its own database copy, its own Synology
# folder, e-mail caught by Mailpit, DWS Hub SSO and the Hub SDK switched off.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Links in e-mails and redirects: the pilot frontend on its private address.
FRONTEND_URL=http://172.31.96.50:8081
APP_PUBLIC_ORIGIN=http://172.31.96.50:8081

# One proxy hop (the frontend nginx) in front of the backend; becomes the WAF / ALB /
# API Gateway hop count later.
TRUST_PROXY=1

# Database: the pilot's own database (DATABASE_URL is in secrets.pilot.env).
# 5 connections per container x 2 containers = 10 on the instance.
PG_POOL_MAX=5
# Empty = whatever DATABASE_URL says (no SSL today). To test TLS once SSL is on:
# DATABASE_SSL=verify-ca and DATABASE_SSL_CA=/app/certs/ApsaraDB-CA-Chain.pem
DATABASE_SSL=
# release.sh runs the schema step once (node backend/migrate.js) before the containers.
SCHEMA_SETUP=skip

# Uploads: the pilot's own Synology folder, mounted at /app/uploads. "true" = the
# backend refuses traffic (/health/ready 503) while that is not a real network mount.
UPLOADS_DIR=/app/uploads
UPLOADS_REQUIRE_NETWORK_FS=true

# E-mail: Mailpit inside the pilot network. Never the real relay in the pilot.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=pm-pilot@energi-up.com

# DWS Hub SSO and Hub SDK: OFF in the pilot (the Hub only knows the production host).
# Sign in with a local password instead (guide section 9).
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
SSO_TOKEN_SECRET=
SSO_JIT_ENABLED=false
HUB_SDK_URL=
HUB_SDK_KEY=
HUB_SDK_RELEASE=

STORE_READ_CACHE_TTL_MS=30000
SHUTDOWN_TIMEOUT_MS=25000
